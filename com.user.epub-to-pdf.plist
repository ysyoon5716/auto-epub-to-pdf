<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.epub-to-pdf</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/convert-epub.sh</string>
    </array>

    <key>WatchPaths</key>
    <array>
        <string>__HOME__/Downloads</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.local/log/epub-to-pdf.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.local/log/epub-to-pdf.err.log</string>
</dict>
</plist>
